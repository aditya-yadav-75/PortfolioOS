# PortfolioOS Environment Configuration

# Server Settings
PORT=4000
NODE_ENV=development
DATABASE_PATH=./portfolio_os.db
CLIENT_URL=http://localhost:5173

# Google Gemini API
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Google Sheets API Integration
# Option A: Service Account Key (path to JSON file relative to server or absolute)
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=
# Option B: Direct Service Account JSON String
GOOGLE_SERVICE_ACCOUNT_JSON=
# Target Google Sheet ID (from the spreadsheet URL: https://docs.google.com/spreadsheets/d/<ID>/edit)
GOOGLE_SPREADSHEET_ID=

# Application Security & Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
